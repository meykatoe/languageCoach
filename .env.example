OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Optional: key used to encrypt the OpenAI API key saved via /settings before
# it's stored in SQLite. If unset, a key is auto-generated into
# data/secret.key on first run (fine for local single-user use). Set this
# explicitly (a Fernet key, e.g. `python -c "from cryptography.fernet import
# Fernet; print(Fernet.generate_key().decode())"`) when deploying somewhere
# the app.db file might be shared, backed up, or exposed.
# APP_SECRET_KEY=
